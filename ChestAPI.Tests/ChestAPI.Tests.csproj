<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests for the pure query/aggregation code. Needs no Valheim install: it compiles just the files
       that contain no Unity or BepInEx types. Run with: dotnet test ChestAPI.Tests -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ChestAPI\Models.cs" Link="Models.cs" />
    <Compile Include="..\ChestAPI\ChestQuery.cs" Link="ChestQuery.cs" />
    <Compile Include="..\ChestAPI\PlayerNames.cs" Link="PlayerNames.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
